# Copie este arquivo para ".env" e preencha. O .env NUNCA vai para o GitHub.

# --- Servidor
PORT=3000
NODE_ENV=production
# DB_PATH=data/aguillera.db
# UPLOADS_DIR=data/arquivos

# --- Gestor (usado só na primeira execução, para criar o seu acesso).
# Depois do primeiro login, troque a senha no app e apague GESTOR_SENHA daqui.
GESTOR_NOME=Jocsan Aguillera
GESTOR_EMAIL=advogadoaguillera@gmail.com
GESTOR_SENHA=

# --- Claude (assistente de gestão, rascunhos e explicações)
# Crie a chave em https://platform.claude.com → API Keys.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Andamento automático (API Pública do DataJud / CNJ)
# A chave pública está em https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=
DATAJUD_INTERVALO_HORAS=6
